---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Illustration from "../../components/Illustration.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import {
  brand,
  homeMetadata,
  locales,
  ui,
  route,
  priorityArticles,
  type Locale,
} from "../../lib/site";
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Locale,
  t = ui[lang];
const entries = (
  await getCollection("articles", (e) => e.data.lang === lang)
).sort(
  (a, b) =>
    priorityArticles.indexOf(a.data.id) - priorityArticles.indexOf(b.data.id),
);
const featured = priorityArticles
  .slice(0, 3)
  .map((id) => entries.find((e) => e.data.id === id))
  .filter((e): e is NonNullable<typeof e> => Boolean(e));
const featurePaths = [
  "features/recording",
  "features/calibration",
  "features/j-card-maker",
];
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: brand,
  applicationCategory: "MultimediaApplication",
  operatingSystem: "macOS, Windows, Linux",
  softwareVersion: "0.1.0",
  description: homeMetadata[lang].description,
  license: "https://www.gnu.org/licenses/gpl-3.0.html",
  isAccessibleForFree: true,
};
---

<Base
  lang={lang}
  title={homeMetadata[lang].title}
  description={homeMetadata[lang].description}
  schema={schema}
  imageScene="workstation"
>
  <section class="hero">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="signal-dot"></span>
        {t.eyebrow}
      </p>
      <h1>
        {t.hero.split("\n").map((line, i) => (
          <span class:list={{ "accent-text": i === 1 }}>{line}</span>
        ))}
      </h1>
      <p class="hero-intro">{t.intro}</p>
      <div class="actions">
        <a class="button" href={route(lang, "download")}>
          {t.primary}
          <span aria-hidden="true">↗</span>
        </a>
        <a class="text-link" href={route(lang, "getting-started")}>
          {t.secondary}
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="status-line">{t.status}</p>
    </div>
    <div class="hero-art">
      <Illustration lang={lang} scene="workstation" eager />
    </div>
  </section>
  <section class="section workspace-intro">
    <div class="section-heading">
      <div>
        <h2>{t.journey}</h2>
      </div>
      <p>{t.journeyText}</p>
    </div>
    <div class="feature-grid">
      {t.featureTitles.map((name, i) => (
        <a class="feature-card" href={route(lang, featurePaths[i])}>
          <span class="feature-number">
            0{i + 1}
            <span aria-hidden="true">↗</span>
          </span>
          <h3>{name}</h3>
          <p>{t.featureTexts[i]}</p>
          <span class="text-link">{t.explore} →</span>
        </a>
      ))}
    </div>
  </section>
  <section class="section editorial-section">
    <div class="section-heading">
      <div>
        <h2>{t.read}</h2>
        <p>{t.readText}</p>
      </div>
      <a class="text-link" href={route(lang, "articles")}>
        {t.allArticles} →
      </a>
    </div>
    <div class="article-grid">
      {featured.map((entry, i) => (
        <ArticleCard entry={entry} lang={lang} number={i} />
      ))}
    </div>
  </section>
</Base>
