---
import { getCollection, render } from "astro:content";
import Base from "../../../layouts/Base.astro";
import { guideLabels } from "../../../lib/guide-navigation";
import ArticleCard from "../../../components/ArticleCard.astro";
import ConnectionGuide from "../../../components/ConnectionGuide.astro";
import {
  ui,
  route,
  absolute,
  categoryFeature,
  type Locale,
} from "../../../lib/site";
export async function getStaticPaths() {
  const entries = await getCollection("articles");
  return entries.map((entry) => ({
    params: { lang: entry.data.lang, id: entry.data.id },
    props: { entry },
  }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const lang = entry.data.lang as Locale,
  t = ui[lang];
const all = await getCollection(
  "articles",
  (e) => e.data.lang === lang && e.data.id !== entry.data.id,
);
const labels = guideLabels[lang];
const resolve = (ids: string[]) =>
  ids.flatMap((id) => {
    const found = all.find((e) => e.data.id === id);
    return found ? [found] : [];
  });
const prerequisites = resolve(entry.data.prerequisites);
const next = resolve(entry.data.next);
const related = resolve(entry.data.related).filter(
  (e) => !entry.data.next.includes(e.data.id),
);
const readTime = Math.max(
  2,
  Math.ceil((entry.body || "").split(/\s+/).length / 180),
);
const schema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.description,
  abstract: entry.data.answer,
  articleSection: t.category[entry.data.category],
  inLanguage: lang,
  dateModified: entry.data.updated.toISOString().slice(0, 10),
  citation: entry.data.sources.map((source) => source.url),
  about: [entry.data.primaryKeyword, ...entry.data.secondaryKeywords],
  author: {
    "@type": "Organization",
    name: t.editorial,
    url: absolute(route(lang, "about"), Astro.site),
  },
  mainEntityOfPage: absolute(
    route(lang, `articles/${entry.data.id}`),
    Astro.site,
  ),
};
---

<Base
  lang={lang}
  title={entry.data.title}
  description={entry.data.description}
  path={`articles/${entry.data.id}`}
  article
  schema={schema}
  imageScene={null}
>
  <article>
    <header class="article-heading page-heading">
      <nav class="breadcrumbs" aria-label={t.home}>
        <a href={route(lang)}>{t.home}</a>
        <span aria-hidden="true">/</span>
        <a href={route(lang, "articles")}>{t.nav[3]}</a>
        <span aria-hidden="true">/</span>
        <span>{t.category[entry.data.category]}</span>
      </nav>
      <p class="eyebrow">{t.category[entry.data.category]}</p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <div class="article-meta">
        <a href={route(lang, "about")}>{t.editorial}</a>
        <span>
          {t.updated}{" "}
          <time datetime={entry.data.updated.toISOString().slice(0, 10)}>
            {entry.data.updated.toLocaleDateString(lang, {
              year: "numeric",
              month: "long",
              day: "numeric",
              timeZone: "UTC",
            })}
          </time>
        </span>
        <span>
          {readTime} {t.minutes}
        </span>
      </div>
    </header>
    <div class="article-layout">
      <aside
        class:list={[
          "article-sidebar",
          { "long-toc": headings.filter((h) => h.depth === 2).length > 8 },
        ]}
      >
        <details open>
          <summary>{t.contents}</summary>
          <ol>
            {headings
              .filter((h) => h.depth === 2)
              .map((h) => (
                <li>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
          </ol>
        </details>
        <a class="text-link" href={route(lang, "articles")}>
          ← {t.back}
        </a>
      </aside>
      <div class="article-main">
        <aside class="article-answer" aria-label={labels.answer}>
          <strong>{labels.answer}</strong>
          <p>{entry.data.answer}</p>
        </aside>
        {prerequisites.length > 0 && (
          <nav class="guide-prerequisites" aria-label={labels.before}>
            <strong>{labels.before}</strong>
            <ul>
              {prerequisites.map((e) => (
                <li>
                  <a href={route(lang, `articles/${e.data.id}`)}>
                    {e.data.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        {entry.data.id === "recording-computer" && (
          <ConnectionGuide lang={lang} direction="record" />
        )}
        {[
          "speed-test",
          "wow-flutter",
          "azimuth-test",
          "playback-level",
        ].includes(entry.data.id) && (
          <ConnectionGuide lang={lang} direction="capture" />
        )}
        <div class="prose">
          <Content />
        </div>
        <section class="sources">
          <h2>{t.sources}</h2>
          <ul>
            {entry.data.sources.map((s) => (
              <li>
                <a href={s.url} rel="external">
                  {s.title} ↗
                </a>
              </li>
            ))}
          </ul>
        </section>
        {next.length > 0 && (
          <nav class="guide-next" aria-label={labels.next}>
            <h2>{labels.next}</h2>
            <ul>
              {next.map((e) => (
                <li>
                  <a href={route(lang, `articles/${e.data.id}`)}>
                    {e.data.title} <span aria-hidden="true">→</span>
                  </a>
                  <p>{e.data.description}</p>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <p class="guide-product-link">
          <a href={route(lang, categoryFeature(entry.data.category))}>
            {t.cta} →
          </a>
        </p>
      </div>
    </div>
  </article>
  {related.length > 0 && (
    <section class="section related-section">
      <h2>{t.related}</h2>
      <div class="article-grid">
        {related.map((e) => (
          <ArticleCard entry={e} lang={lang} />
        ))}
      </div>
    </section>
  )}
  <script>
    const toc = document.querySelector<HTMLDetailsElement>(
      ".article-sidebar details",
    );
    if (toc && window.matchMedia("(max-width: 720px)").matches)
      toc.open = false;
  </script>
</Base>
