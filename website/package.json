{
  "name": "mixtapeforge-website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/astro.mjs dev --host 127.0.0.1 --port 4321",
    "check": "node scripts/astro.mjs check",
    "build": "node scripts/astro.mjs build",
    "preview": "node scripts/astro.mjs preview --host 127.0.0.1 --port 4321",
    "test": "node --test scripts/*.node-test.mjs",
    "verify": "node scripts/verify.mjs",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"scripts/*.mjs\" astro.config.mjs",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"scripts/*.mjs\" astro.config.mjs"
  },
  "dependencies": {
    "astro": "7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "cheerio": "1.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "~5.9.3",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
